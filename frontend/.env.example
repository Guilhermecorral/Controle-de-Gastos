# Em produção, a API usa o proxy same-origin da Vercel para preservar cookies HttpOnly.
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Site Key publica do widget Turnstile. Nao use aqui a Secret Key do backend.
VITE_TURNSTILE_SITE_KEY=
# Em produção, mantenha somente os hostnames homologados no widget da Cloudflare.
VITE_TURNSTILE_ALLOWED_HOSTS=farolfinanceiro.online,www.farolfinanceiro.online
VITE_GA_MEASUREMENT_ID=G-XHGPTH2GXP
VITE_BUILD_COMMIT=local
VITE_APP_VERSION=1.0.0
VITE_HOST=127.0.0.1
VITE_PORT=5173
